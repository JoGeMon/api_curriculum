{
  "compilerOptions": {
    /* Lenguaje */
    "target": "ES2020",

    /* Módulos */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Estructura del proyecto */
    "rootDir": "src",
    "outDir": "dist",

    /* TypeScript */
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Experiencia */
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
